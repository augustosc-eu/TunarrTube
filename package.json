{
  "name": "tunarrtube",
  "version": "0.7.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "prestart": "node scripts/prepare-dev.mjs",
    "start": "next start --hostname 127.0.0.1",
    "start:lan": "next start --hostname 0.0.0.0",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-virtual": "^3.14.25",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "openai": "7.47.0",
    "puppeteer": "25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postject": "1.0.0-alpha.6",
    "prisma": "7.10.1",
    "resedit": "3.1.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "puppeteer@25.16.0": true,
    "fsevents@2.3.3": true
  }
}
