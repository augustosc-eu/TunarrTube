{
  "name": "ytarr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build --webpack",
    "prestart": "node scripts/prepare-dev.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
