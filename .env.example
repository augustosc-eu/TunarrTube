DATABASE_URL="file:./ytarr.db"
# Optional overrides. TunarrTube otherwise discovers both programs dynamically.
# TUNARRTUBE_YTDLP_PATH="/opt/homebrew/bin/yt-dlp"
# TUNARRTUBE_FFMPEG_PATH="/opt/homebrew/bin/ffmpeg"
# TUNARRTUBE_MEDIA_DIR="/absolute/path/to/media"
# TUNARRTUBE_TUNARR_URL="http://127.0.0.1:8000"
# TUNARRTUBE_THUMBNAIL_DIR="/absolute/path/to/thumbnails"
# How many non-download/cache jobs (metadata, thumbnail, sync, tunarr_*, etc.) run concurrently. Downloads
# and cache fills always run one at a time, regardless of this setting, to avoid YouTube rate limiting.
# TUNARRTUBE_GENERAL_WORKERS=3

# AI Programming (optional): set one or both to enable the "AI Programming" order on a Source/Channel.
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# TUNARRTUBE_OPENAI_MODEL="gpt-4o"

# Docker Compose host settings (not read by the TunarrTube process directly).
# TUNARRTUBE_PORT=3000
# TUNARR_PORT=8000
# TZ=UTC
# TUNARR_IMAGE=chrisbenincasa/tunarr:latest

# Existing YTARR_* variables remain supported as legacy aliases.
